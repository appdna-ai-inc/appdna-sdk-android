<?xml version="1.0" encoding="utf-8"?>
<!-- The sample's launcher icon. Play rejects a bundle whose icon is a framework drawable
     (`@android:drawable/sym_def_app_icon`), so the sample ships its own: an adaptive icon here,
     and PNGs in mipmap-*dpi for API 24–25. A plain ring on the brand indigo — nothing customer-specific. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
