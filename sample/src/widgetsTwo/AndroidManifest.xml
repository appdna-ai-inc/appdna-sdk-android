<?xml version="1.0" encoding="utf-8"?>
<!-- Walk build with TWO synthetic widgets (-PappdnaSampleWidgets=two). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="ai.appdna.sample.widget.StreakWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sample_widget_streak_info" />
        </receiver>
        <receiver
            android:name="ai.appdna.sample.widget.TasksWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sample_widget_tasks_info" />
        </receiver>
    </application>
</manifest>
